# ─────────────────────────────────────────────────────────────
# KANNAGI — example environment. Copy to .env and fill in.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# ---------- Branding (see README "Renaming the product") ----------
APP_BRAND_NAME=Kannagi
APP_BRAND_DISPLAY_NAME=Kannagi
APP_BRAND_TAGLINE=Speak safely. Know what's possible. Decide what happens next.
APP_BRAND_SUPPORT_EMAIL=support@example.com
APP_CASE_REF_PREFIX=KN

# ---------- Database ----------
DATABASE_URL=jdbc:postgresql://localhost:5432/app_db
DATABASE_USERNAME=app_user
DATABASE_PASSWORD=change_me_locally
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_locally

# ---------- JWT ----------
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_BASE64_48_BYTES
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_BASE64_48_BYTES
JWT_ISSUER=kannagi-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# ---------- Encryption at rest ----------
# 32 raw bytes, base64 encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
# Separate key for deterministic blind-index lookups (email search)
BLIND_INDEX_KEY=REPLACE_WITH_DIFFERENT_BASE64_32_BYTES
# Separate key for HMAC-SHA256 (IP hashing, keyed digests)
HMAC_SECRET=REPLACE_WITH_DIFFERENT_BASE64_32_BYTES

# ---------- CAPTCHA (Cloudflare Turnstile) ----------
# Leave provider=noop for local dev; set to turnstile for real validation.
CAPTCHA_PROVIDER=noop
CAPTCHA_SECRET=
VITE_TURNSTILE_SITE_KEY=

# ---------- AI provider (Phase 3) ----------
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---------- Speech-to-text (Phase 4) ----------
SPEECH_PROVIDER=mock
SPEECH_API_KEY=
SPEECH_BASE_URL=https://api.openai.com/v1

# ---------- Storage ----------
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=15

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8080
VITE_APP_NAME=Kannagi
VITE_APP_TAGLINE=Speak safely. Know what's possible. Decide what happens next.
